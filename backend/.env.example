# ── Copy to .env and fill in OPENROUTER_API_KEY ────────────────────────────────

# App
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Auth (V1: local JWT. V2: swap to Supabase Auth — the Bearer contract is unchanged)
JWT_SECRET=dev-only-change-me-to-32-plus-random-chars
JWT_EXPIRE_MINUTES=10080

# Database — local docker-compose. Production: paste the Supabase connection string.
DATABASE_URL=postgresql+asyncpg://linguaflow:linguaflow@localhost:5442/linguaflow

# Vector store — "qdrant" (default) or "pgvector". Both run locally.
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Cache / rate limiting / job queue
REDIS_URL=redis://localhost:6390/0

# LLM gateway (required — get a key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=LinguaFlow AI

# Embeddings — OpenRouter serves these too, so no model download is needed.
# EMBEDDING_DIM must match the model's real output size or Qdrant upserts will fail
# (startup asserts this). text-embedding-3-small = 1536.
# For fully-offline dev: EMBEDDING_BACKEND=local + `pip install -e ".[local-embeddings]"`
# (e.g. sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2, dim 384).
EMBEDDING_BACKEND=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# Voice — OpenRouter audio endpoints (/audio/transcriptions + /audio/speech)
STT_MODEL=google/gemini-2.5-flash
TTS_MODEL=openai/gpt-4o-mini-tts
TTS_VOICE=alloy
SPEECH_LANGUAGE=de
MAX_AUDIO_MB=20

# Ingestion limits
MAX_UPLOAD_MB=25
CHUNK_TOKENS=600
CHUNK_OVERLAP_TOKENS=90

# Retrieval
RETRIEVAL_TOP_K=6
SEARCH_STRATEGY=hybrid          # hybrid | dense

# Quotas / rate limits
RATE_LIMIT_PER_MINUTE=30
FREE_MONTHLY_AI_CALLS=500

# Bootstrap admin (created on first startup if absent)
ADMIN_EMAIL=admin@linguaflow.dev
ADMIN_PASSWORD=changeme123
